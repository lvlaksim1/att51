        <tr>
          <td width="10%">Высота</td>
          <td width="10%">Темп-ра</td>
          <td width="10%">Скор.возд.</td>
          <td width="10%">Влажность</td>
          <td width="10%">ТНС</td>
          <td width="10%">Тепл.изл.</td>
          <td width="40%">Доп.информация по измерениям</td>
        </tr>
        <tr>
          <td>0.5</td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td rowspan="3"></td>
        </tr>
        <tr>
          <td>1.0</td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
        <tr>
          <td>1.5</td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      </table>
        Доп. сведения:
      </p>
    </xsl:if>
