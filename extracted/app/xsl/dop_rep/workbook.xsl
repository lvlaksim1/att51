    <xsl:if test="@rad='true'">
      <!-- Здесь можно отредактировать сведения по Ионизиирующее излучение-->
      <p class="factor">
        <hr/>
        <b>Ионизиирующее излучение</b>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Дата (№ даты):<br/>
