        Освещенность (комб.):&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;
        Светильник:<br/>
        Доп. сведения:
      </p>
    </xsl:if>
    
    <xsl:if test="@micro='true'">
