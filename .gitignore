# Default repository exclusions
/dist/
/build/
/work/
/unpacked/
/carved/
/*.exe
/*_decompressed.bin
*.pyc
__pycache__/

# Default protection for files outside the research collection.
*.exe
*.msi
*.zip
*.7z
*.rar
*.dll
*.pdb

# OWNER EXCEPTION: att51 ONLY (2026-10-09).
# Original application files under extracted/ are permitted regardless of
# extension and locally imposed size limits; GitHub still has a hard limit
# of 100 MiB per regular Git object. No modification to repo-factory itself.
!/extracted/
!/extracted/**

# The app's original registration metadata was published manually by the owner.
# No path exclusions apply within extracted/ under the att51 exception.
